# ============================================================
# 本地开发私密配置模板
# 用法：复制本文件到【项目根目录】并命名为 application-local.yml
#   （与 pom.xml 同级，不会打包进 jar；该文件已在 .gitignore 中忽略）
# 也可以不复制文件，改用同名环境变量注入（DB_PASSWORD / ALIPAY_APP_ID 等）
# ============================================================

spring:
  datasource:
    username: root
    password: "你的本地MySQL密码"
  redis:
    password: ""

# JWT 签名密钥（至少 32 字符，生产环境请用随机串并通过环境变量 JWT_SECRET 注入）
jwt:
  secret: "请替换为你自己的随机密钥字符串，至少32个字符"

# 支付宝沙箱：https://open.alipay.com/develop/sandbox/app
alipay:
  app-id: "你的沙箱APPID"
  app-private-key: "你的应用私钥（Java语言版，一行无头尾）"
  public-key: "你的支付宝公钥"
  # 如使用 cpolar / natapp 等内网穿透接收沙箱异步回调，改为你的穿透地址：
  notify-url: http://localhost:8081/alipay/notify
  recharge-notify-url: http://localhost:8081/recharge/notify

# 阿里云百炼 DashScope：https://bailian.console.aliyun.com/
dashscope:
  api-key: "sk-你的APIKey"
  app-id: "你的应用AppId"
